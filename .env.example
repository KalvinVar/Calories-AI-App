# Google Cloud Vision API Credentials
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# USDA FoodData Central API Key
# Get yours at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# Firebase (optional) — enables user accounts & cross-device sync
# 1. Create a project at https://console.firebase.google.com/
# 2. Enable Email/Password auth (Build → Authentication)
# 3. Create a Firestore database (Build → Firestore Database)
# 4. Copy Web API Key and Project ID from Project Settings
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
